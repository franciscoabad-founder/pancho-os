# Copia este archivo a .env y completa los valores reales.
# .env NUNCA sube a Git.

# Resend — correos transaccionales
RESEND_API_KEY=

# URL pública de descarga del Kit IA (Supabase Storage o donde lo alojes)
KIT_DOWNLOAD_URL=

# OS API token (server-to-server con n8n, header X-OS-Token)
OS_API_TOKEN=

# n8n webhook / Grabaciones de voz (transcripcion + resumen al cerebro)
N8N_TRANSCRIBE_URL=

# Cortex — alta de testers desde el OS personal
# Token admin compartido con app-cortex.franciscoabad.com (endpoint POST /api/os/invitar)
CORTEX_ADMIN_TOKEN=
# URL base de la app de Cortex (default: https://app-cortex.franciscoabad.com)
CORTEX_APP_URL=

# Taski: token Bearer para el proxy de chat con Hermes (brain.franciscoabad.com/taski)
TASKI_TOKEN=

# Perfiles reales de Hermes (F2). Cada agente tiene su propio api_server, con su
# propia memoria, publicado por Caddy como /taski-<perfil> en
# brain.franciscoabad.com. Alfred (default) usa TASKI_BASE_URL / TASKI_TOKEN de
# arriba; estos cuatro son opcionales: sin ellos el perfil aparece como "no
# configurado" en el OS y todo lo demas sigue funcionando.
# Si falta TASKI_TOKEN_<PERFIL> se cae al TASKI_TOKEN de arriba.
# Arazza (api_server en 172.18.0.1:8645)
TASKI_BASE_ARAZZA=
TASKI_TOKEN_ARAZZA=
# Nerio (api_server en 172.18.0.1:8646)
TASKI_BASE_NERIO=
TASKI_TOKEN_NERIO=
# Rafik (api_server en 172.18.0.1:8647)
TASKI_BASE_RAFIK=
TASKI_TOKEN_RAFIK=
# Taskr (api_server en 172.18.0.1:8648)
TASKI_BASE_TASKR=
TASKI_TOKEN_TASKR=

# Content Radar — fuentes externas (opcionales; sin ellas el radar usa solo el generador local)
# SerpAPI (https://serpapi.com) — habilita Google Autocomplete y Bing Related Searches
SERPAPI_API_KEY=
# Google Cloud API key con YouTube Data API v3 habilitada — habilita YouTube Search
YOUTUBE_API_KEY=

# Secreto compartido con Hermes para POST /api/hermes/eventos (header x-hermes-secret); sin el, el webhook rechaza todo
HERMES_WEBHOOK_SECRET=
