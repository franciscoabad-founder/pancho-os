---
export const prerender = false;
import OSLayout from '../../../layouts/OSLayout.astro';
import OSContentRadar from '../../../organs/contenido/ui/OSContentRadar';
import PageHeader from '../../../os/components/ui/PageHeader';
---

<OSLayout title="Content Radar">
  <div class="os-fade-up">
    <PageHeader
      eyebrow="Investigacion de contenido"
      title="Content Radar"
      subtitle="Descubre oportunidades de contenido a partir de una palabra semilla."
    />
    <OSContentRadar client:load />
  </div>

  <style is:global>
    @media (max-width: 820px) {
      .os-card-2 { padding: 1rem; }
    }
  </style>
</OSLayout>
